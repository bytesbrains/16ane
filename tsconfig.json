{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/sdk-ts/src",
    "packages/sdk-ts/test",
    "packages/mcp-server/src",
    "packages/mcp-server/test",
    "packages/cli/test",
    "services/sandbox-server/src",
    "services/sandbox-server/test",
    "services/facilitator/src",
    "e2e",
    "scripts",
    "test/web",
    "test/hackathon-kit",
    "examples/hackathon-kit",
    "test/dashboard/*.ts"
  ]
}
