{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.16ane.com/schemas/service-manifest.v0.schema.json",
  "title": "16ane Signed Service Manifest v0 Schema",
  "type": "object",
  "required": [
    "version",
    "service_id",
    "name",
    "description",
    "provider_id",
    "endpoint",
    "capabilities",
    "pricing",
    "payment_protocols",
    "refund_policy",
    "updated_at",
    "expires_at",
    "disclaimer",
    "signature"
  ],
  "properties": {
    "version": { "type": "string", "const": "16ane-service-manifest/v0" },
    "service_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "provider_id": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "endpoint": { "type": "string", "format": "uri" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "maxLength": 64 }
    },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "pricing": {
      "type": "object",
      "required": ["unit", "amount_base_units", "asset", "network", "recipient"],
      "properties": {
        "unit": { "type": "string", "enum": ["request", "1k_tokens", "task"] },
        "amount_base_units": { "type": "string", "pattern": "^[0-9]+$" },
        "asset": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "network": { "type": "string", "pattern": "^eip155:[0-9]+$" },
        "recipient": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
      }
    },
    "payment_protocols": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["x402-v2"] }
    },
    "refund_policy": {
      "type": "object",
      "required": ["mode", "description"],
      "properties": {
        "mode": { "type": "string", "enum": ["MERCHANT_VOLUNTARY_ON_FAILURE", "ESCROW_MILESTONE", "NON_REFUNDABLE"] },
        "description": { "type": "string", "maxLength": 300 }
      }
    },
    "quota": {
      "type": "object",
      "properties": {
        "is_sponsored": { "type": "boolean" },
        "max_calls_per_wallet_per_day": { "type": "integer", "minimum": 0 },
        "campaign_id": { "type": ["string", "null"] }
      }
    },
    "terms_url": { "type": "string", "format": "uri" },
    "contact": { "type": "string", "maxLength": 128 },
    "updated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "disclaimer": { "type": "string", "pattern": "NO CASH VALUE" },
    "signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" }
  }
}
