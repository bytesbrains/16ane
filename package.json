{
  "name": "16ane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p .",
    "test:sdk-ts": "node --experimental-strip-types --test packages/sdk-ts/test/sdk.test.ts packages/sdk-ts/test/send-retry.test.ts packages/sdk-ts/test/keystore.test.ts packages/sdk-ts/test/merchant-replay.test.ts packages/sdk-ts/test/read-consistency.test.ts packages/sdk-ts/test/transactions.test.ts",
    "test:sdk-py": "python3 -m unittest discover -s packages/sdk-py/tests -p 'test_*.py' -v",
    "test:cli": "node --experimental-strip-types --test packages/cli/test/*.test.ts",
    "test:server": "node --experimental-strip-types --test services/sandbox-server/test/*.test.ts",
    "test:e2e": "node --experimental-strip-types --test --test-concurrency=1 e2e/run-scenarios.ts e2e/smoke-script.ts e2e/restart-state.ts e2e/gas-budget.ts e2e/faucet-proof.ts e2e/api-smoke.ts e2e/signed-actions.ts",
    "test:web": "node --experimental-strip-types --test test/web/site.test.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "wrangler": "4.151.1"
  }
}
