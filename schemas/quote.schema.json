{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.16ane.com/schemas/quote.schema.json",
  "title": "16ane x402 v2 PaymentRequired Quote Schema",
  "type": "object",
  "required": ["x402Version", "quote_id", "disclaimer", "accepts"],
  "properties": {
    "x402Version": {
      "type": "integer",
      "const": 2
    },
    "quote_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "service_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "disclaimer": {
      "type": "string",
      "pattern": "NO CASH VALUE"
    },
    "accepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scheme", "network", "asset", "amount_base_units", "payTo", "maxTimeoutSeconds"],
        "properties": {
          "scheme": {
            "type": "string",
            "enum": ["ane-vault-v1", "exact", "ane-txproof-v1"]
          },
          "network": {
            "type": "string",
            "pattern": "^eip155:[0-9]+$"
          },
          "asset": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "amount_base_units": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "payTo": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "maxTimeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "extra": {
            "type": "object",
            "properties": {
              "symbol": { "type": "string", "const": "tANE" },
              "decimals": { "type": "integer", "const": 18 },
              "name": { "type": "string" },
              "version": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
